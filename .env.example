# Optional: If your Actual server uses a different encryption budget password set it here
ACTUAL_BUDGET_ENCRYPTION_PASSWORD=

# Optional: Currency formatting configuration (defaults to USD and en-US)
# ACTUAL_CURRENCY=USD
# ACTUAL_LOCALE=en-US
# Examples:
# - Euro: ACTUAL_CURRENCY=EUR, ACTUAL_LOCALE=de-DE
# - British Pound: ACTUAL_CURRENCY=GBP, ACTUAL_LOCALE=en-GB
# - Japanese Yen: ACTUAL_CURRENCY=JPY, ACTUAL_LOCALE=ja-JP
